---
import { icons } from '../data/icons';

// Ilustración de referencia de un elemento del sistema.
// No es una captura: usa barras de relleno en lugar de datos reales.
interface Props {
  kind:
    | 'document'
    | 'checklist'
    | 'form'
    | 'table'
    | 'timeline'
    | 'alerts'
    | 'bars'
    | 'files'
    | 'assign'
    | 'permit'
    | 'profile'
    | 'route'
    | 'notifs'
    | 'donut'
    | 'stepper'
    | 'gallery'
    | 'calendar'
    | 'gauge'
    | 'kanban'
    | 'builder'
    | 'quiz'
    | 'toggles'
    | 'rating'
    | 'columns'
    | 'tags'
    | 'dashboard';
  title: string;
  rows: string[];
  states?: ('ok' | 'warn')[];
  labels?: [string, string];
  active?: number;
  values?: number[];
  dynamic?: boolean;
  variant?: 'person' | 'truck' | 'vehicle' | 'license';
}

const {
  kind,
  title,
  rows,
  states = [],
  labels = ['Vigente', 'Por vencer'],
  active = -1,
  values = [],
  dynamic = false,
  variant = 'person',
} = Astro.props;

const widths = [72, 54, 84, 46, 66];
const w = (i: number) => widths[i % widths.length];
const blocked = states.includes('warn');
const isWarn = (i: number) => states[i] === 'warn';

const palette = [
  'var(--color-primary-light)',
  'var(--color-accent)',
  'var(--color-primary-dark)',
  'var(--color-gray-400)',
];

// Dona
const R = 38;
const C = 2 * Math.PI * R;
let acc = 0;
const segs = values.map((v, i) => {
  const len = (C * v) / 100;
  const seg = { len, off: -acc, color: palette[i % palette.length] };
  acc += len;
  return seg;
});

// Medidor
const ARC = Math.PI * 60;
const pct = values[0] ?? 65;

// Ruta
const pts = rows.map((_, i) => ({
  x: rows.length > 1 ? 44 + i * (252 / (rows.length - 1)) : 170,
  y: i % 2 === 0 ? 100 : 44,
}));
const routeD = pts
  .map((p, i) => {
    if (i === 0) return `M${p.x} ${p.y}`;
    const q = pts[i - 1];
    const mx = (q.x + p.x) / 2;
    return `C${mx} ${q.y} ${mx} ${p.y} ${p.x} ${p.y}`;
  })
  .join(' ');

// Calendario (35 celdas, el mes empieza en miércoles)
const weekdays = ['L', 'M', 'M', 'J', 'V', 'S', 'D'];
const cells = Array.from({ length: 35 }, (_, i) => i - 1);
---

<div class={`ill ill-${kind}`}>
  <div class="ill-head">
    <span class="ill-dot"></span>
    <span class="ill-title">{title}</span>
    <span class="ill-pill"></span>
  </div>

  <div class="ill-body">
    {kind === 'document' && (
      <>
        {rows.map((r, i) => (
          <div class="doc-row">
            <span class="lbl">{r}</span>
            <span class="sk" style={`width:${w(i)}%`}></span>
          </div>
        ))}
        <div class="doc-foot">
          <span class="stamp"></span>
          <span class="sk" style="width:38%"></span>
        </div>
      </>
    )}

    {kind === 'permit' && (
      <>
        <div class="pm-band">
          <span class="pm-logo"></span>
          <span class="pm-lines">
            <span class="sk" style="width:64%"></span>
            <span class="sk" style="width:40%"></span>
          </span>
        </div>
        {rows.map((r, i) => (
          <div class="doc-row">
            <span class="lbl">{r}</span>
            <span class="sk" style={`width:${w(i)}%`}></span>
          </div>
        ))}
        <div class="pm-foot">
          <span class="qr"></span>
          <span class="pm-sign">
            <span class="sk" style="width:80%"></span>
            <span class="sk" style="width:52%"></span>
          </span>
        </div>
      </>
    )}

    {kind === 'profile' && (
      <>
        <div class="pf-top">
          <span class={`pf-media pf-${variant}`}>
            {(variant === 'truck' || variant === 'vehicle') && (
              <svg viewBox="0 0 24 24" fill="none" aria-hidden="true" set:html={icons.truck} />
            )}
            {variant === 'person' && (
              <svg viewBox="0 0 24 24" fill="none" aria-hidden="true">
                <circle cx="12" cy="8" r="4" />
                <path d="M4 21c0-4.4 3.6-7 8-7s8 2.6 8 7" />
              </svg>
            )}
            {variant === 'license' && (
              <svg viewBox="0 0 24 24" fill="none" aria-hidden="true">
                <rect x="2" y="5" width="20" height="14" rx="2.5" />
                <circle cx="8.5" cy="11" r="2" />
                <line x1="13" y1="10" x2="19" y2="10" />
                <line x1="13" y1="14" x2="18" y2="14" />
              </svg>
            )}
          </span>
          <span class="pf-lines">
            <span class="sk" style="width:70%"></span>
            <span class="sk" style="width:46%"></span>
          </span>
        </div>
        <div class="chips">
          {rows.map((r, i) => (
            <span class={`dchip ${isWarn(i) ? 'warn' : 'ok'}`}>
              <i></i>
              {r}
            </span>
          ))}
        </div>
        <div class="pf-foot">
          <span class="sk" style="width:84%"></span>
          <span class="sk" style="width:58%"></span>
        </div>
      </>
    )}

    {kind === 'checklist' &&
      rows.map((r, i) => (
        <div class={`chk ${isWarn(i) ? 'warn' : 'ok'}`}>
          <span class="box">{isWarn(i) ? '!' : '✓'}</span>
          <span class="lbl">{r}</span>
          <span class="sk" style={`width:${w(i)}%`}></span>
        </div>
      ))}

    {kind === 'form' && (
      <>
        {rows.map((r) => (
          <div class="fld">
            <span class="lbl">{r}</span>
            <span class="inp"></span>
          </div>
        ))}
        {dynamic && <span class="add">+ Campo</span>}
      </>
    )}

    {kind === 'builder' && (
      <>
        {rows.map((r, i) => (
          <div class={`bld ${i === active ? 'sel' : ''}`}>
            <span class="grip" aria-hidden="true">⋮⋮</span>
            <span class="lbl">{r}</span>
            <span class="bld-type"></span>
          </div>
        ))}
        <span class="add">+ Campo</span>
      </>
    )}

    {kind === 'table' &&
      rows.map((r, i) => (
        <div class="trow">
          <span class="lbl">{r}</span>
          <span class="sk" style={`width:${w(i)}%`}></span>
          <span class={`chip ${isWarn(i) ? 'warn' : 'ok'}`}>
            {isWarn(i) ? labels[1] : labels[0]}
          </span>
        </div>
      ))}

    {kind === 'timeline' && (
      <ol class="tl">
        {rows.map((r, i) => (
          <li class={`${i < active ? 'done' : ''} ${i === active ? 'now' : ''}`}>
            <span class="tl-dot"></span>
            <span class="lbl">{r}</span>
          </li>
        ))}
      </ol>
    )}

    {kind === 'stepper' && (
      <>
        <ol class="stp">
          {rows.map((r, i) => (
            <li class={`${i < active ? 'done' : ''} ${i === active ? 'now' : ''}`}>
              <span class="stp-dot">{i < active ? '✓' : i + 1}</span>
              <span class="lbl">{r}</span>
            </li>
          ))}
        </ol>
        <div class="stp-card">
          <span class="sk" style="width:70%"></span>
          <span class="sk" style="width:48%"></span>
        </div>
      </>
    )}

    {kind === 'route' && (
      <svg class="rt" viewBox="0 0 340 140" role="presentation">
        <path class="rt-line" d={routeD} fill="none" />
        {pts.map((p, i) => (
          <>
            <circle
              class={`rt-pt ${i < active ? 'done' : ''} ${i === active ? 'now' : ''}`}
              cx={p.x}
              cy={p.y}
              r={i === active ? 8 : 6}
            />
            <text class="rt-txt" x={p.x} y={i % 2 === 0 ? p.y + 24 : p.y - 14} text-anchor="middle">
              {rows[i]}
            </text>
          </>
        ))}
      </svg>
    )}

    {kind === 'alerts' &&
      rows.map((r, i) => (
        <div class={`alr ${isWarn(i) ? 'warn' : 'ok'}`}>
          <span class="alr-ic">{isWarn(i) ? '!' : '✓'}</span>
          <span class="lbl">{r}</span>
          <span class={`chip ${isWarn(i) ? 'warn' : 'ok'}`}>
            {isWarn(i) ? labels[1] : labels[0]}
          </span>
        </div>
      ))}

    {kind === 'notifs' &&
      rows.map((r, i) => (
        <div class={`ntf ${isWarn(i) ? 'warn' : 'ok'}`}>
          <span class="ntf-ic">{isWarn(i) ? '!' : '✓'}</span>
          <span class="ntf-txt">
            <span class="lbl">{r}</span>
            <span class="sk" style={`width:${w(i)}%`}></span>
          </span>
          <span class="ntf-time"></span>
        </div>
      ))}

    {kind === 'bars' &&
      rows.map((r, i) => (
        <div class="bar">
          <span class="lbl">{r}</span>
          <span class="track">
            <span class="fill" style={`width:${values[i] ?? 60}%`}></span>
          </span>
        </div>
      ))}

    {kind === 'columns' && (
      <div class="cols">
        {rows.map((r, i) => (
          <div class="col">
            <span class="col-track">
              <span class={`col-bar ${i === active ? 'hl' : ''}`} style={`height:${values[i] ?? 50}%`}></span>
            </span>
            <span class="lbl">{r}</span>
          </div>
        ))}
      </div>
    )}

    {kind === 'dashboard' && (
      <>
        <div class="kpis">
          {rows.slice(0, 3).map((r, i) => (
            <div class="kpi">
              <span class="lbl">{r}</span>
              <span class={`sk big ${i === 1 ? 'acc' : ''}`} style={`width:${w(i)}%`}></span>
            </div>
          ))}
        </div>
        <div class="cols mini">
          {values.map((v, i) => (
            <div class="col">
              <span class="col-track">
                <span class={`col-bar ${i === active ? 'hl' : ''}`} style={`height:${v}%`}></span>
              </span>
            </div>
          ))}
        </div>
      </>
    )}

    {kind === 'donut' && (
      <div class="dn">
        <svg class="dn-svg" viewBox="0 0 100 100" role="presentation">
          <g transform="rotate(-90 50 50)">
            <circle cx="50" cy="50" r={R} fill="none" stroke-width="14" style="stroke:var(--color-gray-100)" />
            {segs.map((s) => (
              <circle
                cx="50"
                cy="50"
                r={R}
                fill="none"
                stroke-width="14"
                stroke-dasharray={`${s.len} ${C - s.len}`}
                stroke-dashoffset={s.off}
                style={`stroke:${s.color}`}
              />
            ))}
          </g>
        </svg>
        <ul class="dn-leg">
          {rows.map((r, i) => (
            <li>
              <i style={`background:${palette[i % palette.length]}`}></i>
              <span class="lbl">{r}</span>
            </li>
          ))}
        </ul>
      </div>
    )}

    {kind === 'gauge' && (
      <>
        <div class="gg">
          <svg class="gg-svg" viewBox="0 0 160 92" role="presentation">
            <path class="gg-bg" d="M20 80 A60 60 0 0 1 140 80" fill="none" stroke-width="14" stroke-linecap="round" />
            <path
              class="gg-fg"
              d="M20 80 A60 60 0 0 1 140 80"
              fill="none"
              stroke-width="14"
              stroke-linecap="round"
              stroke-dasharray={`${(ARC * pct) / 100} ${ARC}`}
            />
          </svg>
          <span class="sk" style="width:30%"></span>
        </div>
        {rows.map((r, i) => (
          <div class="gg-row">
            <span class="lbl">{r}</span>
            <span class="sk" style={`width:${w(i)}%`}></span>
          </div>
        ))}
      </>
    )}

    {kind === 'calendar' && (
      <div class="cal">
        {weekdays.map((d) => (
          <span class="cal-wd">{d}</span>
        ))}
        {cells.map((d) => (
          <span
            class={`cal-day ${d < 1 || d > 31 ? 'off' : ''} ${values.includes(d) ? 'mark' : ''} ${d === active ? 'warn' : ''}`}
          >
            {d >= 1 && d <= 31 ? d : ''}
          </span>
        ))}
      </div>
    )}

    {kind === 'kanban' && (
      <div class="kb" style={`grid-template-columns:repeat(${rows.length}, minmax(0, 1fr))`}>
        {rows.map((r, i) => (
          <div class={`kb-col ${i === active ? 'now' : ''}`}>
            <span class="lbl">{r}</span>
            {Array.from({ length: values[i] ?? 2 }).map((_, k) => (
              <span class="kb-card">
                <span class="sk" style={`width:${w(i + k)}%`}></span>
                <span class="sk" style="width:40%"></span>
              </span>
            ))}
          </div>
        ))}
      </div>
    )}

    {kind === 'quiz' && (
      <>
        <div class="qz-q">
          <span class="sk" style="width:90%"></span>
          <span class="sk" style="width:62%"></span>
        </div>
        {rows.map((r, i) => (
          <div class={`qz-opt ${i === active ? 'sel' : ''}`}>
            <span class="radio"></span>
            <span class="lbl">{r}</span>
          </div>
        ))}
      </>
    )}

    {kind === 'toggles' &&
      rows.map((r, i) => (
        <div class="tgl">
          <span class="lbl">{r}</span>
          <span class="seg">
            <span class={`seg-o ${isWarn(i) ? '' : 'on-ok'}`}>Sí</span>
            <span class={`seg-o ${isWarn(i) ? 'on-warn' : ''}`}>No</span>
          </span>
        </div>
      ))}

    {kind === 'rating' &&
      rows.map((r, i) => (
        <div class="rate">
          <span class="lbl">{r}</span>
          <span class="stars" aria-hidden="true">
            {[1, 2, 3, 4, 5].map((n) => (
              <span class={`star ${n <= (values[i] ?? 3) ? 'on' : ''}`}>★</span>
            ))}
          </span>
        </div>
      ))}

    {kind === 'tags' && (
      <>
        <div class="chips">
          {rows.map((r, i) => (
            <span class={`dchip lg ${isWarn(i) ? 'warn' : 'ok'}`}>
              <i></i>
              {r}
            </span>
          ))}
        </div>
        <div class="pf-foot">
          <span class="sk" style="width:82%"></span>
          <span class="sk" style="width:54%"></span>
          <span class="sk" style="width:68%"></span>
        </div>
      </>
    )}

    {kind === 'files' && (
      <div class="files">
        {rows.map((r) => (
          <div class="file">
            <span class="file-ic"></span>
            <span class="lbl">{r}</span>
          </div>
        ))}
      </div>
    )}

    {kind === 'gallery' && (
      <div class="gal">
        {rows.map((r) => (
          <div class="tile">
            <span class="tile-img">
              <svg viewBox="0 0 24 24" fill="none" aria-hidden="true">
                <rect x="3" y="4" width="18" height="16" rx="2" />
                <circle cx="9" cy="10" r="1.6" />
                <path d="M4 18l5-5 4 4 3-3 4 4" />
              </svg>
            </span>
            <span class="lbl">{r}</span>
          </div>
        ))}
        <div class="tile tile-add">
          <span class="tile-img">+</span>
          <span class="lbl">Agregar</span>
        </div>
      </div>
    )}

    {kind === 'assign' && (
      <>
        {rows.map((r, i) => (
          <div class={`asg ${isWarn(i) ? 'warn' : 'ok'}`}>
            <span class="asg-ic">{isWarn(i) ? '!' : '✓'}</span>
            <span class="asg-name">{r}</span>
            <span class="asg-st">
              {isWarn(i) ? 'Requisito pendiente' : 'Requisitos vigentes'}
            </span>
          </div>
        ))}
        <div class={`asg-btn ${blocked ? 'is-blocked' : ''}`}>Asignar servicio</div>
        {blocked && (
          <p class="asg-note">Asignación bloqueada hasta cumplir los requisitos</p>
        )}
      </>
    )}
  </div>
</div>

<style>
  .ill {
    width: 100%;
    max-width: 380px;
    overflow: hidden;
    background: var(--color-white);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-md);
    box-shadow: var(--shadow-md);
  }

  .ill-head {
    display: flex;
    align-items: center;
    gap: 0.6rem;
    padding: 0.7rem 0.9rem;
    background: var(--color-bg-alt);
    border-bottom: 1px solid var(--color-border);
  }

  .ill-dot {
    flex: 0 0 10px;
    width: 10px;
    height: 10px;
    border-radius: 50%;
    background: var(--color-accent);
  }

  .ill-title {
    min-width: 0;
    font-family: var(--font-heading);
    font-size: 0.85rem;
    font-weight: 600;
    line-height: 1.25;
    color: var(--color-ink);
  }

  .ill-pill {
    flex: 0 0 46px;
    width: 46px;
    height: 8px;
    margin-left: auto;
    border-radius: 4px;
    background: var(--color-gray-200);
  }

  .ill-body {
    display: flex;
    flex-direction: column;
    gap: 0.6rem;
    padding: 0.9rem;
  }

  /* Las etiquetas pueden saltar de línea: nada se corta */
  .lbl {
    min-width: 0;
    font-size: 0.78rem;
    font-weight: 600;
    line-height: 1.25;
    color: var(--color-text-muted);
    overflow-wrap: anywhere;
  }

  .sk {
    display: block;
    height: 8px;
    border-radius: 4px;
    background: var(--color-gray-200);
  }

  .sk.big {
    height: 14px;
    background: var(--color-primary-light);
    opacity: 0.8;
  }

  .sk.big.acc {
    background: var(--color-accent);
  }

  .chip {
    margin-left: auto;
    padding: 0.15rem 0.6rem;
    border-radius: 99px;
    font-size: 0.7rem;
    font-weight: 600;
    white-space: nowrap;
  }

  .chip.ok {
    background: color-mix(in srgb, var(--color-primary-light) 14%, var(--color-white));
    color: var(--color-primary-dark);
  }

  .chip.warn {
    background: color-mix(in srgb, var(--color-accent) 14%, var(--color-white));
    color: var(--color-accent-dark);
  }

  /* Píldoras con punto de estado (perfil y etiquetas) */
  .chips {
    display: flex;
    flex-wrap: wrap;
    gap: 0.45rem;
  }

  .dchip {
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    padding: 0.25rem 0.65rem;
    border: 1px solid var(--color-border);
    border-radius: 99px;
    font-size: 0.72rem;
    font-weight: 600;
    line-height: 1.2;
    color: var(--color-ink);
  }

  .dchip i {
    flex: 0 0 8px;
    width: 8px;
    height: 8px;
    border-radius: 50%;
  }

  .dchip.ok i { background: var(--color-primary-light); }
  .dchip.warn { border-color: var(--color-accent); }
  .dchip.warn i { background: var(--color-accent); }

  .dchip.lg {
    padding: 0.4rem 0.9rem;
    font-size: 0.78rem;
  }

  /* Documento */
  .doc-row {
    display: grid;
    grid-template-columns: minmax(0, 132px) minmax(0, 1fr);
    align-items: center;
    gap: 0.6rem;
  }

  .doc-foot {
    display: flex;
    align-items: center;
    gap: 0.8rem;
    margin-top: 0.3rem;
    padding-top: 0.8rem;
    border-top: 1px solid var(--color-border);
  }

  .stamp {
    flex: 0 0 34px;
    width: 34px;
    height: 34px;
    border: 2px dashed var(--color-gray-400);
    border-radius: 50%;
  }

  /* Permiso con código QR */
  .pm-band {
    display: flex;
    align-items: center;
    gap: 0.7rem;
    padding: 0.6rem 0.7rem;
    background: color-mix(in srgb, var(--color-primary-light) 12%, var(--color-white));
    border-radius: var(--radius-sm);
  }

  .pm-logo {
    flex: 0 0 30px;
    width: 30px;
    height: 30px;
    border-radius: 8px;
    background: var(--color-primary-dark);
  }

  .pm-lines,
  .pf-lines,
  .pm-sign {
    display: flex;
    flex: 1;
    flex-direction: column;
    gap: 0.4rem;
  }

  .pm-foot {
    display: flex;
    align-items: center;
    gap: 0.9rem;
    margin-top: 0.2rem;
    padding-top: 0.8rem;
    border-top: 1px solid var(--color-border);
  }

  .qr {
    flex: 0 0 52px;
    width: 52px;
    height: 52px;
    padding: 4px;
    border: 1px solid var(--color-border);
    border-radius: 4px;
    background:
      repeating-conic-gradient(var(--color-ink) 0% 25%, transparent 0% 50%) 4px 4px / 8px 8px content-box,
      var(--color-white);
    background-clip: content-box, border-box;
  }

  /* Perfil: persona, vehículo o licencia */
  .pf-top {
    display: flex;
    align-items: center;
    gap: 0.8rem;
  }

  .pf-media {
    display: grid;
    place-items: center;
    flex: 0 0 52px;
    width: 52px;
    height: 52px;
    color: var(--color-primary-dark);
    background: color-mix(in srgb, var(--color-primary-light) 12%, var(--color-white));
    border: 1.5px solid var(--color-primary-light);
  }

  .pf-person { border-radius: 50%; }
  .pf-truck,
  .pf-vehicle { border-radius: 12px; }
  .pf-license { width: 64px; flex-basis: 64px; border-radius: 8px; }

  .pf-media svg {
    width: 28px;
    height: 28px;
    stroke: currentColor;
    stroke-width: 1.6;
    stroke-linecap: round;
    stroke-linejoin: round;
  }

  .pf-foot {
    display: flex;
    flex-direction: column;
