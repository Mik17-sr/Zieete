---

<section class="solution" id="solucion">
  <div class="container">
    <div class="sol-header">
      <h2>Cada fricción, una respuesta operativa.</h2>
    </div>

    <div class="sol-grid" id="sol-grid">
      {tiles.map((t, i) => (
        <article class="sol-tile" style={`--i:${i};`}>
          <span class="sol-before">Antes: <s>{t.before}</s></span>
          <div class="sol-icon">
            <svg viewBox="0 0 24 24" width="22" height="22" aria-hidden="true" set:html={t.icon} />
          </div>
          <h3>{t.title}</h3>
          <p>{t.desc}</p>
        </article>
      ))}

    </div>
  </div>
</section>

<style>
  .solution {
    --sl-accent: var(--color-accent);
    --sl-ink: var(--color-ink);
    --sl-muted: var(--color-text-muted);
    --sl-line: var(--color-border);
    padding-block: var(--space-2xl);
    background: var(--color-white);
  }

  .sol-header {
    max-width: 62ch;
    margin-bottom: var(--space-lg);
  }

  .sol-header h2 {
    max-width: 16ch;
  }

  .sol-header p {
    font-size: var(--fs-md);
  }

  .sol-grid {
    display: grid;
    grid-template-columns: repeat(6, minmax(0, 1fr));
    gap: 1.1rem;
  }

  .sol-tile {
    --mx: 50%;
    --my: 0%;
    position: relative;
    grid-column: span 2;
    padding: 1.4rem 1.4rem 1.5rem;
    background: var(--color-white);
    border: 1px solid var(--sl-line);
    border-radius: var(--radius-md);
    overflow: hidden;
    transition:
      transform 0.35s cubic-bezier(0.22, 1, 0.36, 1),
      border-color 0.3s ease,
      box-shadow 0.3s ease,
      opacity 0.6s ease;
  }

  /* Luz que sigue al cursor */
  .sol-tile::before {
    content: "";
    position: absolute;
    inset: 0;
    pointer-events: none;
    background: radial-gradient(
      220px circle at var(--mx) var(--my),
      color-mix(in srgb, var(--sl-accent) 10%, transparent),
      transparent 68%
    );
    opacity: 0;
    transition: opacity 0.25s ease;
  }

  .sol-tile:hover {
    transform: translateY(-3px);
    border-color: color-mix(in srgb, var(--sl-accent) 45%, var(--sl-line));
    box-shadow: 0 12px 26px -18px color-mix(in srgb, var(--sl-accent) 50%, transparent);
  }

  .sol-tile:hover::before { opacity: 1; }

  .sol-tile > * { position: relative; }

  .sol-before {
    display: inline-block;
    margin-bottom: 1.1rem;
    padding: 0.2rem 0.65rem;
    border-radius: 99px;
    background: var(--color-bg-alt);
    font-size: 0.74rem;
    font-weight: 600;
    color: var(--sl-muted);
  }

  /* La palabra del problema se tacha cuando aparece la tarjeta */
  .sol-before s {
    position: relative;
    text-decoration: none;
  }

  .sol-before s::after {
    content: "";
    position: absolute;
    left: 0;
    top: 54%;
    width: 0;
    height: 2px;
    border-radius: 2px;
    background: var(--sl-accent);
    transition: width 0.55s cubic-bezier(0.22, 1, 0.36, 1);
  }

  .sol-icon {
    display: grid;
    place-items: center;
    width: 46px;
    height: 46px;
    margin-bottom: 0.9rem;
    border-radius: 13px;
    background: color-mix(in srgb, var(--sl-accent) 11%, var(--color-white));
    color: var(--sl-accent);
    transition: background-color 0.3s ease, color 0.3s ease, transform 0.35s cubic-bezier(0.34, 1.56, 0.64, 1);
  }

  .sol-icon svg {
    width: 22px;
    height: 22px;
    fill: none;
    stroke: currentColor;
    stroke-width: 1.8;
    stroke-linecap: round;
    stroke-linejoin: round;
  }

  .sol-tile:hover .sol-icon {
    background: var(--sl-accent);
    color: var(--color-white);
    transform: rotate(-6deg) scale(1.08);
  }

  .sol-tile h3 {
    margin: 0 0 0.4rem;
    font-family: var(--font-heading);
    font-size: 1.12rem;
    color: var(--sl-ink);
  }

  .sol-tile p {
    margin: 0;
    font-size: 0.93rem;
    line-height: 1.55;
    color: var(--sl-muted);
  }

  /* ---------- Entrada al hacer scroll ---------- */
  .solution.has-js:not(.is-in) .sol-tile {
    opacity: 0;
    transform: translateY(26px) scale(0.97);
  }

  .solution.is-in .sol-tile {
    transition-delay: calc(var(--i) * 90ms), 0s, 0s, calc(var(--i) * 90ms);
  }

  .solution.is-in .sol-before s::after {
    width: 100%;
    transition-delay: calc(var(--i) * 90ms + 0.55s);
  }

  /* Terminada la entrada, el hover responde sin retraso */
  .solution.is-settled .sol-tile {
    transition-delay: 0s;
  }

  @media (max-width: 960px) {
    .sol-tile { grid-column: span 3; }
  }

  @media (max-width: 600px) {
    .sol-grid { grid-template-columns: minmax(0, 1fr); }
    .sol-tile { grid-column: auto; }
  }
</style>

<script>
  const section = document.getElementById('solucion');
  const grid = document.getElementById('sol-grid');

  if (section && grid) {
    section.classList.add('has-js');

    // Luz que sigue al cursor dentro de cada tarjeta
    grid.addEventListener('pointermove', (e) => {
      const tile = (e.target as HTMLElement).closest('.sol-tile') as HTMLElement | null;
      if (!tile) return;
      const r = tile.getBoundingClientRect();
      tile.style.setProperty('--mx', e.clientX - r.left + 'px');
      tile.style.setProperty('--my', e.clientY - r.top + 'px');
    });

    // Entrada escalonada al llegar a la sección
    if ('IntersectionObserver' in window) {
      const io = new IntersectionObserver(
        (entries) => {
          if (entries[0].isIntersecting) {
            section.classList.add('is-in');
            setTimeout(() => section.classList.add('is-settled'), 1800);
            io.disconnect();
          }
        },
        { threshold: 0.15 }
      );
      io.observe(grid);
    } else {
      section.classList.add('is-in', 'is-settled');
    }
  }
</script>