    function type(el, text, speed, id, done) {
        var i = 0;
        el.textContent = '';
        el.classList.add('is-typing');
        (function step() {
            if (id !== run) return;
            i++;
            el.textContent = text.slice(0, i);
            if (i < text.length) {
                setTimeout(step, speed);
            } else {
                el.classList.remove('is-typing');
                if (done) done();
            }
        })();
    }

    function renderItems(items, id) {
        itemsEl.innerHTML = '';
        items.forEach(function (it, i) {
            setTimeout(function () {
                if (id !== run) return;
                var li = document.createElement('li');
                var badge = document.createElement('span');
                badge.className = 'item-icon';
                badge.innerHTML = '<svg viewBox="0 0 24 24" width="15" height="15" fill="none" stroke="currentColor" aria-hidden="true">' + ICONS[it[1]] + '</svg>';
                var label = document.createElement('span');
                label.className = 'item-text';
                li.appendChild(badge);
                li.appendChild(label);
                itemsEl.appendChild(li);
                type(label, it[0], 14, id);
            }, i * 140);
        });
    }

