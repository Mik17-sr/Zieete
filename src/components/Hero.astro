        var d = DATA[key];

        row.querySelectorAll('[data-mod]').forEach(function (el) {
            el.classList.toggle('is-active', el.getAttribute('data-mod') === key);
        });
        navBtns.forEach(function (b) {
            b.classList.toggle('is-current', b.getAttribute('data-key') === key);
        });

        var node = row.querySelector('.network-node[data-mod="' + key + '"] .node-icon');
        iconEl.innerHTML = node ? node.innerHTML : GENERIC_ICON;
        iconWrap.classList.remove('pop');
        void iconWrap.offsetWidth;
        iconWrap.classList.add('pop');

        itemsEl.innerHTML = '';
        titleEl.classList.remove('is-typing');
        textEl.classList.remove('is-typing');
        srEl.textContent = d.title + '. ' + d.text;

        if (instant) {
            titleEl.textContent = d.title;
            textEl.textContent = d.text;
            renderItems(d.items, id);
            return;
        }

        type(titleEl, d.title, 22, id, function () {
            type(textEl, d.text, 11, id, function () {
                renderItems(d.items, id);
            });
        });
    }

    row.querySelectorAll('.network-node[data-mod]').forEach(function (el) {
        var key = el.getAttribute('data-mod');
        ['mouseenter', 'focusin', 'click'].forEach(function (ev) {
            el.addEventListener(ev, function () { show(key); });
        });
    });

    var hub = row.querySelector('.network-hub');
    if (hub) {
        ['mouseenter', 'focusin', 'click'].forEach(function (ev) {
            hub.addEventListener(ev, function () { show('general'); });
        });
    }

    navBtns.forEach(function (b) {
        var key = b.getAttribute('data-key');
        b.addEventListener('click', function () { show(key); });
        b.addEventListener('mouseenter', function () { show(key); });
    });

    show('general', true);
})();
</script>

