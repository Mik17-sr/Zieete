---
import { navLinks } from "../data/navigation.ts";
---

<header class="navbar">
    <div class="navbar-inner container">
        <a href="#" class="navbar-logo" aria-label="ZIEETE — Inicio">
            <img src="/images/zieete-logo.png" alt="ZIEETE" />
        </a>

        <nav class="navbar-nav" aria-label="Navegación principal">
            <ul>
                {
                    navLinks.map((link) => (
                        <li>
                            <a href={link.href} class="nav-link">
                                {link.label}
                            </a>
                        </li>
                    ))
                }
            </ul>
        </nav>

        <div class="navbar-actions">
            <a href="#contacto" class="btn btn-primary">Solicitar demo</a>
        </div>

        <button
            class="navbar-toggle"
            aria-label="Abrir menú"
            aria-expanded="false"
            id="navbar-toggle"
        >
            <span></span>
            <span></span>
            <span></span>
        </button>
    </div>

    <nav class="navbar-mobile" aria-label="Navegación móvil" id="navbar-mobile">
        <ul>
            {
                navLinks.map((link) => (
                    <li>
                        <a href={link.href} class="mobile-link">
                            {link.label}
                        </a>
                    </li>
                ))
            }
            <li>
                <a href="#contacto" class="btn btn-primary btn-full"
                    >Solicitar demo</a
                >
            </li>
        </ul>
    </nav>
</header>

<style>
    /* Base Glassmorphism Navbar */
    .navbar {
        position: sticky;
        top: 0;
        z-index: 50;
        background: rgba(255, 255, 255, 0.85);
        backdrop-filter: blur(12px);
        -webkit-backdrop-filter: blur(12px);
        border-bottom: 1px solid var(--color-border, rgba(0, 0, 0, 0.08));
        transition:
            border-color 0.3s ease,
            box-shadow 0.3s ease;
    }

    .navbar:hover {
        box-shadow: 0 4px 20px -5px rgba(0, 0, 0, 0.05);
    }

    .navbar-inner {
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: var(--space-md);
        padding-block: var(--space-xs);
    }

    .navbar-logo {
        position: relative;
        display: inline-flex;
        align-items: center;
        padding-block: 0.25rem;
        text-decoration: none;
    }

    .navbar-logo img {
        height: 48px;
        width: auto;
        transition: transform 0.2s ease;
    }

    .navbar-logo:hover img {
        animation: floatLogo 1s ease-in-out infinite alternate;
    }

    .navbar-logo::after {
        content: "";
        position: absolute;
        bottom: -4px;
        left: 50%;
        width: 0;
        height: 2.5px;
        background: linear-gradient(90deg, #FF5A26 0%, #007CB8 100%);
        border-radius: 4px;
        box-shadow: 0 2px 8px rgba(0, 124, 184, 0.4);
        transition: width 0.2s cubic-bezier(0.25, 1, 0.5, 1), left 0.2s cubic-bezier(0.25, 1, 0.5, 1);
    }

    .navbar-logo:hover::after {
        width: 60%;
        left: 20%;
    }

    .navbar-nav ul {
        display: flex;
        gap: calc(var(--space-md) * 1.2);
        list-style: none;
        margin: 0;
        padding: 0;
    }

    .nav-link {
        position: relative;
        color: var(--color-text);
        font-weight: 500;
        font-size: var(--fs-xs);
        text-decoration: none;
        padding-block: 0.4rem;
        transition: color 0.25s ease;
    }

    /* Línea inferior animada (Glow Gradient) */
    .nav-link::after {
        content: "";
        position: absolute;
        bottom: 0;
        left: 50%;
        width: 0;
        height: 2px;
        background: linear-gradient(90deg, #ff5a26, #007cb8);
        border-radius: 2px;
        transition:
            width 0.3s cubic-bezier(0.25, 1, 0.5, 1),
            left 0.3s cubic-bezier(0.25, 1, 0.5, 1);
    }

    .nav-link:hover {
        color: var(--color-primary, #0e2c54);
    }

    .nav-link:hover::after {
        width: 100%;
        left: 0;
    }

    /* Botón Premium CTA con Shimmer y Elevación */
    .btn {
        display: inline-block;
        font-family: var(--font-heading);
        font-weight: 600;
        font-size: var(--fs-xs);
        padding: 0.65rem 1.35rem;
        border-radius: var(--radius-sm, 8px);
        text-decoration: none;
        position: relative;
        overflow: hidden;
        z-index: 1;
        transition:
            transform 0.25s cubic-bezier(0.34, 1.56, 0.64, 1),
            box-shadow 0.25s ease;
    }

    .btn-primary {
        background: var(--color-accent, #007cb8);
        color: var(--color-white, #ffffff);
        box-shadow: 0 2px 10px rgba(0, 124, 184, 0.2);
    }

    /* Brillo interno tipo Shimmer */
    .btn-primary::before {
        content: "";
        position: absolute;
        top: 0;
        left: -100%;
        width: 100%;
        height: 100%;
        background: linear-gradient(
            90deg,
            transparent,
            rgba(255, 255, 255, 0.25),
            transparent
        );
        transition: left 0.6s ease;
        z-index: -1;
    }

    .btn-primary:hover {
        transform: translateY(-2px);
        box-shadow: 0 6px 20px rgba(0, 124, 184, 0.35);
    }

    .btn-primary:hover::before {
        left: 100%;
    }

    .btn-primary:active {
        transform: translateY(0);
    }

    /* Botón Hamburguesa Animado a "X" */
    .navbar-toggle {
        display: none;
        flex-direction: column;
        justify-content: center;
        align-items: center;
        gap: 6px;
        width: 36px;
        height: 36px;
        background: transparent;
        border: none;
        cursor: pointer;
        padding: 0;
        z-index: 60;
    }

    .navbar-toggle span {
        display: block;
        width: 22px;
        height: 2px;
        background: var(--color-ink, #0e2c54);
        border-radius: 2px;
        transition:
            transform 0.3s cubic-bezier(0.4, 0, 0.2, 1),
            opacity 0.2s ease;
    }

    /* Estado interactivo animación X */
    .navbar-toggle.is-active span:nth-child(1) {
        transform: translateY(8px) rotate(45deg);
    }

    .navbar-toggle.is-active span:nth-child(2) {
        opacity: 0;
        transform: translateX(-8px);
    }

    .navbar-toggle.is-active span:nth-child(3) {
        transform: translateY(-8px) rotate(-45deg);
    }

    /* Menú Móvil Desplegable con Animación */
    .navbar-mobile {
        display: none;
        background: rgba(255, 255, 255, 0.98);
        backdrop-filter: blur(16px);
        border-bottom: 1px solid var(--color-border, rgba(0, 0, 0, 0.08));
        overflow: hidden;
    }

    .navbar-mobile.is-open {
        display: block;
        animation: slideDown 0.35s cubic-bezier(0.16, 1, 0.3, 1) forwards;
    }

    .navbar-mobile ul {
        list-style: none;
        margin: 0;
        padding: var(--space-md) var(--space-sm);
        display: flex;
        flex-direction: column;
        gap: var(--space-xs);
    }

    .mobile-link {
        display: block;
        padding: 0.6rem var(--space-xs);
        color: var(--color-text);
        font-weight: 500;
        text-decoration: none;
        border-radius: 6px;
        transition:
            background 0.2s ease,
            color 0.2s ease,
            transform 0.2s ease;
    }

    .mobile-link:hover {
        background: rgba(0, 124, 184, 0.06);
        color: var(--color-accent, #007cb8);
        transform: translateX(4px);
    }

    .btn-full {
        width: 100%;
        text-align: center;
        margin-top: var(--space-xs);
    }

    @keyframes floatLogo {
        0% {
            transform: translateY(0px);
        }
        100% {
            transform: translateY(-4px);
        }
    }

    /* Keyframes de animación móvil */
    @keyframes slideDown {
        from {
            opacity: 0;
            transform: translateY(-12px);
        }
        to {
            opacity: 1;
            transform: translateY(0);
        }
    }

    /* Responsive */
    @media (max-width: 860px) {
        .navbar-nav,
        .navbar-actions {
            display: none;
        }

        .navbar-toggle {
            display: flex;
        }
    }
</style>

<script>
    const toggle = document.getElementById("navbar-toggle");
    const mobileNav = document.getElementById("navbar-mobile");

    toggle?.addEventListener("click", () => {
        const isOpen = mobileNav?.classList.toggle("is-open");
        toggle.classList.toggle("is-active", isOpen);
        toggle.setAttribute("aria-expanded", String(!!isOpen));
    });
</script>
