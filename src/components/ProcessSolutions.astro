---
import fs from 'node:fs';
import path from 'node:path';
import Illustration from './Illustration.astro';
import { solutions } from '../data/solutions';
import { icons } from '../data/icons.ts';

const titleOf = (id: string) => solutions.find((s) => s.id === id)?.title ?? id;

// Si existe una captura real en public/screenshots/{area}-{elemento}.(webp|png|jpg),
// reemplaza automáticamente a la ilustración de ese elemento.
const exts = ['webp', 'png', 'jpg'];
const shotOf = (area: string, item: string): string | null => {
  const ext = exts.find((e) =>
    fs.existsSync(path.join(process.cwd(), 'public', 'screenshots', `${area}-${item}.${e}`))
  );
  return ext ? `/screenshots/${area}-${item}.${ext}` : null;
};
---

<section class="process" id="soluciones" aria-labelledby="process-title">
  <div class="container">
    <div class="process-header">
      <h2 id="process-title">Tareas reales detrás de cada proceso.</h2>
    </div>

    <div class="rail" id="rail" role="tablist" aria-label="Procesos de ZIEETE" style="--p:0">
      <div class="rail-line" aria-hidden="true"><span class="rail-fill"></span></div>

      {solutions.map((s, i) => (
        <button
          type="button"
          class="rail-node"
          role="tab"
          id={`tab-${s.id}`}
          aria-controls={`panel-${s.id}`}
          aria-selected={i === 0 ? 'true' : 'false'}
          tabindex={i === 0 ? 0 : -1}
          data-index={i}
        >
          <span class="node-dot">
            <svg viewBox="0 0 24 24" fill="none" aria-hidden="true" set:html={icons[s.icon]} />
          </span>
          <span class="node-name">{s.title}</span>
        </button>
      ))}
    </div>

    <p class="sr-only" id="art-live" aria-live="polite"></p>

    <div class="panels">
      {solutions.map((s, i) => (
        <div
          class="panel"
          role="tabpanel"
          id={`panel-${s.id}`}
          aria-labelledby={`tab-${s.id}`}
          hidden={i !== 0}
        >
          <div class="panel-head">
            <h3 class="panel-title">{s.title}</h3>
            <p class="panel-group">{s.group}</p>
          </div>

          <div class="panel-body">
            <!-- Columna principal: elementos seleccionables y diferenciador -->
            <div class="panel-main">
              <h4 class="panel-sub">Qué gestionas</h4>
              <p class="panel-hint">Elige un elemento para ver cómo se vería.</p>

              <ul class="items">
                {s.items.map((item, k) => (
                  <li style={`--d:${k * 45}ms`}>
                    <button
                      type="button"
                      class={`item-btn ${k === 0 ? 'is-active' : ''}`}
                      aria-pressed={k === 0 ? 'true' : 'false'}
                      data-art={`${s.id}-${item.id}`}
                      data-label={item.label}
                    >
                      <span class="item-icon" aria-hidden="true">
                        <svg viewBox="0 0 24 24" fill="none" set:html={icons[item.icon]} />
                      </span>
                      <span>{item.label}</span>
                    </button>
                  </li>
                ))}
              </ul>

              <div class="highlight">
                <h4>{s.highlight.title}</h4>
                <p>{s.highlight.text}</p>
                {s.highlight.consequence && (
                  <p class="highlight-cons">{s.highlight.consequence}</p>
                )}
              </div>
            </div>

            <!-- Columna lateral: ilustración (o captura real), resultado y conexiones -->
            <div class="panel-side">
              <div class="stage">
                {s.items.map((item, k) => {
                  const shot = shotOf(s.id, item.id);
                  return (
                    <div class="art" id={`art-${s.id}-${item.id}`} hidden={k !== 0}>
                      {shot ? (
                        <button
                          type="button"
                          class="shot-btn"
                          data-src={shot}
                          data-alt={`Captura de ${item.label} en ZIEETE`}
                          aria-label={`Ampliar la captura de ${item.label}`}
                        >
                          <img
                            src={shot}
                            alt={`Captura de ${item.label} en ZIEETE`}
                            loading="lazy"
                            decoding="async"
                          />
                          <span class="shot-zoom" aria-hidden="true">Ampliar</span>
                        </button>
                      ) : (
                        <Illustration {...item.art} />
                      )}
                    </div>
                  );
                })}
              </div>

              <p class="panel-outcome">
                <strong>Qué obtienes</strong>
                {s.outcome}
              </p>

              <p class="panel-conn">
                <strong>Conectado con</strong>
                {s.connections.map((id) => (
                  <button type="button" class="conn-chip" data-goto={id}>
                    {titleOf(id)}
                    <span aria-hidden="true">→</span>
                  </button>
                ))}
              </p>

              <a href="#contacto" class="panel-cta btn btn-secondary">Conocer ZIEETE</a>
            </div>
          </div>
        </div>
      ))}
    </div>
  </div>

  <dialog class="shot-dialog" id="shot-dialog" aria-label="Captura ampliada">
    <form method="dialog">
      <button class="shot-close" aria-label="Cerrar">✕</button>
    </form>
    <img src="" alt="" id="shot-dialog-img" />
  </dialog>
</section>

<style>
  .process {
    --zt-blue: #0066ff;
    --zt-blue-soft: #eaf2ff;
    padding-block: var(--space-2xl);
  }

  .process-header {
    max-width: 66ch;
    margin-bottom: var(--space-xl);
  }

  .process-header h2 {
    max-width: 14ch;
  }

  .process-header p {
    font-size: var(--fs-md);
  }

  .sr-only {
    position: absolute;
    width: 1px;
    height: 1px;
    margin: -1px;
    padding: 0;
    overflow: hidden;
    clip: rect(0, 0, 0, 0);
    white-space: nowrap;
    border: 0;
  }

  /* Línea de proceso */
  .rail {
    position: relative;
    display: grid;
    grid-template-columns: repeat(5, 1fr);
    margin-bottom: var(--space-lg);
  }

  .rail-line {
    position: absolute;
    top: 28px;
    left: 10%;
    right: 10%;
    height: 2px;
    background: var(--color-border);
  }

  .rail-fill {
    display: block;
    height: 100%;
    width: calc(var(--p) * 1%);
    background: var(--zt-blue);
    transition: width 0.5s cubic-bezier(0.22, 1, 0.36, 1);
  }

  .rail-node {
    position: relative;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 0.7rem;
    padding: 0;
    background: none;
    border: none;
    cursor: pointer;
    font-family: var(--font-body);
    outline: none;
  }

  .node-dot {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 56px;
    height: 56px;
    border-radius: 50%;
    background: var(--color-white);
    border: 1.8px solid color-mix(in srgb, var(--zt-blue) 45%, #ffffff);
    color: var(--zt-blue);
    transition: background-color 0.25s ease, border-color 0.25s ease,
      color 0.25s ease, transform 0.3s cubic-bezier(0.34, 1.56, 0.64, 1);
  }

  .node-dot svg {
    width: 24px;
    height: 24px;
    stroke: currentColor;
    stroke-width: 1.5;
    stroke-linecap: round;
    stroke-linejoin: round;
  }

  .node-name {
    max-width: 14ch;
    text-align: center;
    font-size: var(--fs-xs);
    font-weight: 600;
    line-height: 1.3;
    color: var(--color-text-muted);
    transition: color 0.2s ease;
  }

  .rail-node:hover .node-dot,
  .rail-node:focus-visible .node-dot {
    transform: scale(1.1);
    border-color: var(--zt-blue);
  }

  .rail-node:focus-visible .node-dot {
    outline: 2px solid var(--color-primary-light);
    outline-offset: 3px;
  }

  .rail-node[aria-selected='true'] .node-dot {
    background: var(--zt-blue);
    border-color: var(--zt-blue);
    color: var(--color-white);
    transform: scale(1.12);
  }

  .rail-node[aria-selected='true'] .node-name {
    color: var(--color-ink);
  }

  /* Paneles */
  .panel {
    padding: var(--space-lg);
    background: linear-gradient(180deg, rgba(255,255,255,0.7), rgba(247,248,250,0.9));
    border: 1px solid var(--color-border);
    border-radius: var(--radius-lg);
    box-shadow: inset 0 1px 0 rgba(255,255,255,0.5);
  }

  .panel[hidden] {
    display: none;
  }

  .panel-head {
    margin-bottom: var(--space-md);
  }

  .panel-title {
    margin-bottom: 0.2rem;
    font-size: var(--fs-xl);
  }

  .panel-group {
    margin: 0;
    font-size: var(--fs-xs);
    font-weight: 600;
    color: var(--color-primary);
  }

  .panel-body {
    display: grid;
    grid-template-columns: 1fr 1.05fr;
    gap: var(--space-lg);
    align-items: start;
  }

  .panel-sub {
    margin-bottom: 0.2rem;
    font-size: var(--fs-sm);
    color: var(--color-primary-dark);
  }

  .panel-hint {
    margin: 0 0 var(--space-sm);
    font-size: 0.8rem;
    color: var(--color-gray-600);
  }

  /* Elementos seleccionables */
  .items {
    list-style: none;
    margin: 0 0 var(--space-md);
    padding: 0;
    display: flex;
    flex-direction: column;
    gap: 0.35rem;
  }

  .item-btn {
    display: flex;
    align-items: center;
    gap: 0.6rem;
    width: 100%;
    padding: 0.55rem 0.8rem;
    text-align: left;
    background: transparent;
    border: 1px solid transparent;
    border-radius: var(--radius-sm);
    font-family: var(--font-body);
    font-size: var(--fs-xs);
    font-weight: 500;
    line-height: 1.35;
    color: var(--color-ink);
    cursor: pointer;
    transition: background-color 0.2s ease, border-color 0.2s ease;
  }

  .item-icon {
    flex: 0 0 auto;
    display: grid;
    place-items: center;
    width: 28px;
    height: 28px;
    border-radius: 8px;
    background: var(--zt-blue-soft);
    color: var(--zt-blue);
    transition: background-color 0.25s ease, color 0.25s ease, box-shadow 0.25s ease;
  }

  .item-icon svg {
    width: 15px;
    height: 15px;
    fill: none;
    stroke: currentColor;
    stroke-width: 1.8;
    stroke-linecap: round;
    stroke-linejoin: round;
  }

  .item-icon svg * {
    fill: none;
  }

  .item-btn::after {
    content: '→';
    margin-left: auto;
    color: var(--color-accent);
    opacity: 0;
    transform: translateX(-4px);
    transition: opacity 0.2s ease, transform 0.2s ease;
  }

  .item-btn:hover {
    background: var(--color-white);
    border-color: var(--color-border);
  }

  .item-btn:focus-visible {
    outline: 2px solid var(--color-primary-light);
    outline-offset: 2px;
  }

  .item-btn.is-active {
    background: var(--color-white);
    border-color: var(--color-accent);
    box-shadow: 0 10px 20px -16px rgba(0, 102, 255, 0.8);
    font-weight: 600;
  }

  .item-btn:hover .item-icon,
  .item-btn.is-active .item-icon {
    background: var(--zt-blue);
    color: #ffffff;
    box-shadow: 0 8px 16px -6px color-mix(in srgb, var(--zt-blue) 60%, transparent);
  }

  .item-btn.is-active::after {
    opacity: 1;
    transform: translateX(0);
  }

  /* Lo que lo hace distinto */
  .highlight {
    padding: 1.1rem 1.2rem;
    background: var(--color-white);
    border: 1px solid var(--color-border);
    border-left: 3px solid var(--color-accent);
    border-radius: var(--radius-sm);
  }

  .highlight h4 {
    margin-bottom: 0.35rem;
    font-size: var(--fs-sm);
    color: var(--color-ink);
  }

  .highlight p {
    margin: 0;
    font-size: var(--fs-xs);
    line-height: 1.55;
  }

  .highlight .highlight-cons {
    margin-top: 0.5rem;
    font-weight: 600;
    color: var(--color-primary-dark);
  }

  /* Escenario de la ilustración */
  .stage {
    position: relative;
    display: grid;
    place-items: center;
    min-height: 340px;
    margin-bottom: var(--space-sm);
    padding: var(--space-md);
    background: var(--color-white);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-md);
  }

  .art {
    width: 100%;
    display: grid;
    place-items: center;
  }

  .art[hidden] {
    display: none;
  }


  @media (prefers-reduced-motion: no-preference) {
    .art:not([hidden]) {
      animation: art-in 0.3s ease-out both;
    }

    .panel:not([hidden]) .items li {
      animation: item-in 0.4s ease-out both;
      animation-delay: var(--d);
    }
  }

  @keyframes art-in {
    from { opacity: 0; transform: translateY(8px); }
    to { opacity: 1; transform: translateY(0); }
  }

  @keyframes item-in {
    from { opacity: 0; transform: translateY(6px); }
    to { opacity: 1; transform: translateY(0); }
  }

  /* Captura real (reemplaza la ilustración) */
  .shot-btn {
    position: relative;
    display: block;
    width: 100%;
    padding: 0;
    overflow: hidden;
    background: var(--color-white);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-md);
    box-shadow: var(--shadow-md);
    cursor: zoom-in;
  }

  .shot-btn img {
    display: block;
    width: 100%;
    height: auto;
    max-height: 420px;
    object-fit: contain;
    background: var(--color-white);
  }

  .shot-zoom {
    position: absolute;
    right: 0.7rem;
    bottom: 0.7rem;
    padding: 0.25rem 0.7rem;
    border-radius: 99px;
    background: var(--color-primary-dark);
    color: var(--color-white);
    font-size: 0.75rem;
    font-weight: 600;
    opacity: 0;
    transition: opacity 0.2s ease;
  }

  .shot-btn:hover .shot-zoom,
  .shot-btn:focus-visible .shot-zoom {
    opacity: 1;
  }

  /* Resultado y conexiones */
  .panel-outcome {
    margin: 0 0 var(--space-sm);
    padding: 0.9rem 1.1rem;
    background: color-mix(in srgb, var(--zt-blue-soft) 55%, var(--color-white));
    border: 1px solid color-mix(in srgb, var(--zt-blue) 20%, var(--color-border));
    border-radius: var(--radius-sm);
    font-size: var(--fs-xs);
    color: var(--color-ink);
  }

  .panel-outcome strong {
    display: block;
    margin-bottom: 0.15rem;
    font-family: var(--font-heading);
    color: var(--color-primary-dark);
  }

  .panel-cta {
    display: inline-flex;
    justify-content: center;
    width: 100%;
    margin-top: var(--space-sm);
    padding-block: 0.8rem;
  }

  .panel-conn {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.45rem;
    margin: 0;
  }

  .panel-conn strong {
    margin-right: 0.2rem;
    font-family: var(--font-heading);
    font-size: var(--fs-xs);
    color: var(--color-primary-dark);
  }

  .conn-chip {
    display: inline-flex;
    align-items: center;
    gap: 0.35rem;
    padding: 0.3rem 0.75rem;
    background: var(--color-white);
    border: 1px solid var(--color-border);
    border-radius: 99px;
    font-size: 0.8rem;
    font-weight: 600;
    color: var(--color-primary-dark);
    cursor: pointer;
    transition: border-color 0.2s ease, color 0.2s ease;
  }

  .conn-chip span {
    transition: transform 0.2s ease;
  }

  .conn-chip:hover,
  .conn-chip:focus-visible {
    border-color: var(--color-accent);
    color: var(--color-accent-dark);
  }

  .conn-chip:hover span,
  .conn-chip:focus-visible span {
    transform: translateX(3px);
  }

  /* Captura ampliada */
  .shot-dialog {
    max-width: min(92vw, 1200px);
    padding: 0.6rem;
    border: none;
    border-radius: var(--radius-md);
    background: var(--color-white);
    box-shadow: var(--shadow-md);
  }

  .shot-dialog::backdrop {
    background: rgba(13, 13, 13, 0.7);
  }

  .shot-dialog img {
    display: block;
    max-width: 100%;
    max-height: 82vh;
    margin: 0 auto;
    border-radius: var(--radius-sm);
  }

  .shot-dialog form {
    display: flex;
    justify-content: flex-end;
    margin-bottom: 0.4rem;
  }

  .shot-close {
    width: 32px;
    height: 32px;
    border: 1px solid var(--color-border);
    border-radius: 50%;
    background: var(--color-white);
    color: var(--color-ink);
    cursor: pointer;
  }

  .shot-close:hover,
  .shot-close:focus-visible {
    border-color: var(--color-accent);
    color: var(--color-accent);
  }

  @media (max-width: 860px) {
    .panel {
      padding: var(--space-md);
    }

    .process-header h2 {
      max-width: none;
    }

    /* La ilustración va primero y queda fija mientras se recorre la lista,
       pero es compacta para no tapar la ventana. */
    .panel-body {
      display: flex;
      flex-direction: column;
    }

    .panel-side {
      display: contents;
    }

    .stage {
      order: 1;
      position: sticky;
      top: 76px; /* ajusta a la altura real de tu header */
      z-index: 4;
      min-height: 0;
      padding: 0.6rem;
      box-shadow: var(--shadow-md);
    }


    .shot-btn img {
      max-height: 200px;
    }

    .panel-main {
      order: 2;
    }

    .panel-outcome {
      order: 3;
    }

    .panel-conn {
      order: 4;
    }
  }

  @media (max-width: 640px) {
    .node-name {
      display: none;
    }

    .node-dot {
      width: 48px;
      height: 48px;
    }

    .rail-line {
      top: 24px;
    }
  }
</style>

<script>
  const rail = document.getElementById('rail');
  const live = document.getElementById('art-live');
  const tabs = Array.from(document.querySelectorAll<HTMLButtonElement>('.rail-node'));
  const panels = Array.from(document.querySelectorAll<HTMLElement>('.panel'));

  function select(index: number, focus = false) {
    tabs.forEach((tab, i) => {
      const active = i === index;
      tab.setAttribute('aria-selected', String(active));
      tab.tabIndex = active ? 0 : -1;
      if (active && focus) tab.focus();
    });
    panels.forEach((panel, i) => {
      panel.hidden = i !== index;
    });
    rail?.style.setProperty('--p', String((index / (tabs.length - 1)) * 100));
  }

  tabs.forEach((tab, i) => {
    tab.addEventListener('click', () => select(i));
    tab.addEventListener('keydown', (e) => {
      let next = i;
      if (e.key === 'ArrowRight') next = (i + 1) % tabs.length;
      else if (e.key === 'ArrowLeft') next = (i - 1 + tabs.length) % tabs.length;
      else if (e.key === 'Home') next = 0;
      else if (e.key === 'End') next = tabs.length - 1;
      else return;
      e.preventDefault();
      select(next, true);
    });
  });

  // Elementos de cada proceso: al elegir uno cambia la ilustración
  document.querySelectorAll<HTMLElement>('.panel').forEach((panel) => {
    const buttons = Array.from(panel.querySelectorAll<HTMLButtonElement>('.item-btn'));
    const arts = Array.from(panel.querySelectorAll<HTMLElement>('.art'));

    function pick(btn: HTMLButtonElement) {
      buttons.forEach((b) => {
        const on = b === btn;
        b.classList.toggle('is-active', on);
        b.setAttribute('aria-pressed', String(on));
      });
      arts.forEach((a) => {
        a.hidden = a.id !== `art-${btn.dataset.art}`;
      });
      if (live) live.textContent = `Mostrando: ${btn.dataset.label ?? ''}`;
    }

    buttons.forEach((btn) => {
      btn.addEventListener('click', () => pick(btn));
      btn.addEventListener('focus', () => pick(btn));
      btn.addEventListener('pointerenter', (e) => {
        if (e.pointerType === 'mouse') pick(btn);
      });
    });
  });

  // Los chips "Conectado con" saltan a la pestaña del proceso relacionado
  document.querySelectorAll<HTMLButtonElement>('.conn-chip').forEach((chip) => {
    chip.addEventListener('click', () => {
      const index = tabs.findIndex((t) => t.id === `tab-${chip.dataset.goto}`);
      if (index >= 0) select(index, true);
    });
  });

  // Ampliar una captura real en un diálogo
  const dialog = document.getElementById('shot-dialog') as HTMLDialogElement | null;
  const dialogImg = document.getElementById('shot-dialog-img') as HTMLImageElement | null;

  document.querySelectorAll<HTMLButtonElement>('.shot-btn').forEach((btn) => {
    btn.addEventListener('click', () => {
      if (!dialog || !dialogImg) return;
      dialogImg.src = btn.dataset.src ?? '';
      dialogImg.alt = btn.dataset.alt ?? '';
      dialog.showModal();
    });
  });

  dialog?.addEventListener('click', (e) => {
    if (e.target === dialog) dialog.close();
  });
</script>