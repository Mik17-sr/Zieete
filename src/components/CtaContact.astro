---
import logoZieete from '../assets/brand/logo-zieete.png';
---
<section class="cta-contact" id="contacto" aria-labelledby="cta-contact-title">
  <div class="container">
    <div class="cta-shell">
      <div class="cta-copy">
        <div class="eyebrow">Contacto</div>
        <h2 id="cta-contact-title">Hablemos del proceso que quieres mejorar.</h2>
        <p>
          Cuéntanos cómo se gestiona hoy y enfocamos la demostración en los puntos
          que requieren más seguimiento.
        </p>
        <figure class="contact-mark" aria-hidden="true">
          <img
            src={logoZieete.src}
            alt=""
            width={logoZieete.width}
            height={logoZieete.height}
            loading="eager"
            fetchpriority="low"
            decoding="async"
          />
        </figure>
      </div>

      <form class="contact-form" id="contact-form">
        <div class="form-field">
          <label for="contact-name">Nombre</label>
          <input id="contact-name" name="nombre" type="text" autocomplete="name" required />
        </div>
        <div class="form-field">
          <label for="contact-company">Empresa</label>
          <input id="contact-company" name="empresa" type="text" autocomplete="organization" required />
        </div>
        <div class="form-field">
          <label for="contact-email">Correo electrónico</label>
          <input id="contact-email" name="correo" type="email" autocomplete="email" required />
        </div>
        <div class="form-field">
          <label for="contact-phone">Teléfono <span>(opcional)</span></label>
          <input id="contact-phone" name="telefono" type="tel" autocomplete="tel" />
        </div>
        <div class="form-field form-field--wide">
          <label for="contact-subject">Asunto</label>
          <select id="contact-subject" name="asunto" required>
            <option value="" selected disabled>Selecciona un motivo</option>
            <option value="demo">Solicitar una demostración</option>
            <option value="informacion">Información comercial</option>
            <option value="otro">Otro</option>
          </select>
        </div>
        <div class="form-field form-field--wide">
          <label for="contact-message">Mensaje</label>
          <textarea id="contact-message" name="mensaje" rows="4" required></textarea>
        </div>
        <div class="form-submit form-field--wide">
          <button class="btn btn-primary" type="submit">Preparar solicitud</button>
          <p class="form-note" id="contact-form-note">
            El envío aún no está conectado. Los datos no se envían ni se guardan.
          </p>
          <p class="form-status" role="status" aria-live="polite"></p>
        </div>
      </form>
    </div>
  </div>
</section>

<style>
  .cta-contact {
    padding-block: clamp(2.75rem, 4vw, 4rem);
    background: var(--color-bg-alt);
  }

  .cta-shell {
    display: grid;
    grid-template-columns: 1.2fr 1fr;
    gap: clamp(2rem, 5vw, 4.5rem);
    align-items: center;
    padding: clamp(1.5rem, 3vw, 2.5rem);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-sm);
    background: var(--color-white);
    box-shadow: var(--shadow-sm);
  }

  .eyebrow {
    display: inline-flex;
    align-items: center;
    padding: 0.4rem 0.8rem;
    border-radius: 999px;
    background: rgba(32, 103, 160, 0.08);
    color: var(--color-primary-dark);
    font-size: 0.72rem;
    font-weight: 700;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    margin-bottom: 1rem;
  }

  .cta-copy h2 {
    max-width: 12ch;
    margin-bottom: 0.75rem;
  }

  .cta-copy p {
    max-width: 60ch;
    font-size: var(--fs-md);
    margin: 0;
  }

  .contact-mark {
    width: min(100%, 250px);
    margin: 1.5rem 0 0;
    perspective: 850px;
  }

  .contact-mark img {
    display: block;
    width: 100%;
    height: auto;
    transform-style: preserve-3d;
    filter:
      drop-shadow(0 1px 0 rgba(32, 103, 160, 0.62))
      drop-shadow(0 3px 0 rgba(36, 74, 133, 0.38))
      drop-shadow(0 9px 10px rgba(13, 13, 13, 0.14));
    animation: brand-float 6s ease-in-out infinite;
  }

  @keyframes brand-float {
    0%, 100% {
      transform: perspective(850px) rotateX(7deg) rotateY(-10deg) translate3d(0, 0, 0);
    }
    50% {
      transform: perspective(850px) rotateX(9deg) rotateY(-7deg) translate3d(0, -5px, 8px);
    }
  }

  .contact-form {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 1rem;
    min-width: 0;
  }

  .form-field {
    display: grid;
    align-content: start;
    gap: 0.4rem;
    min-width: 0;
  }

  .form-field--wide {
    grid-column: 1 / -1;
  }

  .form-field label {
    color: var(--color-ink);
    font-size: 0.84rem;
    font-weight: 600;
  }

  .form-field label span {
    color: var(--color-text-muted);
    font-weight: 400;
  }

  .form-field input,
  .form-field select,
  .form-field textarea {
    width: 100%;
    min-height: 2.8rem;
    padding: 0.65rem 0.75rem;
    border: 1px solid var(--color-border);
    border-radius: var(--radius-sm);
    background: var(--color-white);
    color: var(--color-ink);
    font: inherit;
  }

  .form-field textarea {
    min-height: 7.5rem;
    resize: vertical;
  }

  .form-field input:focus-visible,
  .form-field select:focus-visible,
  .form-field textarea:focus-visible {
    outline: 2px solid var(--color-primary);
    outline-offset: 2px;
    border-color: var(--color-primary);
  }

  .form-submit {
    display: grid;
    justify-items: start;
    gap: 0.65rem;
    margin-top: 0.2rem;
  }

  .form-note,
  .form-status {
    margin: 0;
    font-size: 0.78rem;
  }

  .form-status:empty {
    display: none;
  }

  .form-status {
    color: var(--color-primary-dark);
    font-weight: 600;
  }

  @media (max-width: 720px) {
    .cta-shell {
      grid-template-columns: 1fr;
      gap: 2rem;
    }

    .contact-mark {
      width: min(100%, 210px);
      margin-top: 1.1rem;
    }

    .contact-form {
      grid-template-columns: 1fr;
    }

    .form-field--wide {
      grid-column: auto;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .contact-mark img {
      animation: none;
      transform: perspective(850px) rotateX(7deg) rotateY(-8deg);
    }
  }
</style>

<script>
  const contactForm = document.querySelector<HTMLFormElement>('#contact-form');
  const contactStatus = contactForm?.querySelector<HTMLElement>('.form-status');

  contactForm?.addEventListener('submit', (event) => {
    event.preventDefault();
    if (contactStatus) {
      contactStatus.textContent = 'El formulario está completo, pero el envío aún no está configurado. No se han enviado tus datos.';
    }
  });
</script>
